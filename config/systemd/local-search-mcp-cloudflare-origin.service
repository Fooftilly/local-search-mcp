# Managed by local-search-mcp; contains no credentials.
[Unit]
Description=Optional Cloudflare private-host loopback MCP adapter
# Keep the adapter running across gateway restarts: its fixed upstream then
# returns 502 until the authenticated gateway is healthy again.
Wants=local-search-mcp-remote-gateway.service
After=local-search-mcp-remote-gateway.service

[Service]
Type=simple
WorkingDirectory=$ROOT
ExecStart=$EXE -m remote_agent_cloudflare_origin --serve-loopback
Restart=on-failure
RestartSec=30s
UMask=0077
NoNewPrivileges=true
# The adapter validates the same strict private file ancestry. Its fixed
# authenticated gateway alone runs the host-root guard at startup and on
# every admitted request; this adapter must not run sudo, so it retains
# NoNewPrivileges=true. Avoid user-service mount namespaces that remap
# root-owned ancestors to UID 65534. Keep UMask=0077 and loopback-only ingress.
PrivateTmp=false
ProtectSystem=false
ProtectHome=false
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6

[Install]
WantedBy=default.target
