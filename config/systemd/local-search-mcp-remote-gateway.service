# Managed by local-search-mcp; contains no credentials.
[Unit]
Description=Optional authenticated remote MCP loopback gateway
Wants=local-search-mcp-bridge.service
After=local-search-mcp-bridge.service

[Service]
Type=simple
WorkingDirectory=$ROOT
ExecStart=$EXE -m remote_agent_server --serve-loopback
Restart=on-failure
RestartSec=30s
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6

[Install]
WantedBy=default.target
