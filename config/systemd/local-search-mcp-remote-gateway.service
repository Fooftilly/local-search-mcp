# Managed by local-search-mcp; contains no credentials.
[Unit]
Description=Optional authenticated remote MCP loopback gateway
Wants=local-search-mcp-bridge.service
After=local-search-mcp-bridge.service

[Service]
Type=simple
WorkingDirectory=$ROOT
ExecStart=$EXE -m remote_agent_server --serve-loopback
Restart=on-failure
RestartSec=30s
UMask=0077
# The gateway invokes the preinstalled exact NOPASSWD root guard via sudo
# before forwarding EVERY request. NoNewPrivileges would make sudo fail.
# Keep this isolated to the privileged guard probe; never change sudoers.
NoNewPrivileges=false
# Under systemd --user, sandbox features that install a seccomp or mount
# restriction can *implicitly* enable NoNewPrivileges even when set false.
# The authenticated gateway must perform the narrowly scoped host-root
# sudo NOPASSWD egress-guard probe at startup and on every admitted request.
# On Arch Linux, RestrictAddressFamilies set NoNewPrivs=1 and broke the guard,
# while an otherwise identical unfiltered user service had NoNewPrivs=0 and
# passed. Do not enable it here until host-root guard delegation is redesigned.
# Mount namespaces also map host-root ancestors to UID 65534, breaking the
# credential store's strict ownership validation.
# Keep unprivileged service ownership, UMask, exact loopback bind, and guard.
PrivateTmp=false
ProtectSystem=false
ProtectHome=false

[Install]
WantedBy=default.target
