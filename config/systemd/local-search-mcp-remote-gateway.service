# Managed by local-search-mcp; contains no credentials.
[Unit]
Description=Optional authenticated remote MCP loopback gateway
Wants=local-search-mcp-bridge.service
After=local-search-mcp-bridge.service

[Service]
Type=simple
WorkingDirectory=$ROOT
ExecStart=$EXE -m remote_agent_server --serve-loopback
Restart=on-failure
RestartSec=30s
UMask=0077
# The gateway invokes the preinstalled exact NOPASSWD root guard via sudo
# before forwarding EVERY request. NoNewPrivileges would make sudo fail.
# Keep this isolated to the privileged guard probe; never change sudoers.
NoNewPrivileges=false
# A user-service mount namespace remaps unmapped host root directories to
# UID 65534, invalidating our strict private-file ancestor ownership checks.
# It also prevents the gateway's narrowly authorized host-root sudo guard
# from working. Run as the same unprivileged user *without* a user namespace.
# Retain its UMask, fixed loopback listener, guard checks and syscall filter.
PrivateTmp=false
ProtectSystem=false
ProtectHome=false
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK

[Install]
WantedBy=default.target
